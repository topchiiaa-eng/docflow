# Подключение к Supabase (ДЗ-5). Скопируйте в .env.local и заполните.
# Без этих переменных приложение работает в демо-режиме на мок-данных.
#
# Значения: Supabase Dashboard → Project Settings → API.
# ANON key — публичный клиентский ключ (защиту данных обеспечивает RLS);
# SERVICE_ROLE key сюда НЕ вписывать никогда.
VITE_SUPABASE_URL=https://ваш-проект.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
